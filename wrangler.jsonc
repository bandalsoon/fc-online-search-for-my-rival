{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fc-online-rival-archive",
  "main": "dist/worker.js",
  "compatibility_date": "2026-08-16",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
